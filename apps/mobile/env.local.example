# Public runtime configuration only. Never place an API secret in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Public display token bundled in the app. Keep the SDK download token out of
# this file and configure it as RNMAPBOX_MAPS_DOWNLOAD_TOKEN in EAS instead.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token
