{
  "name": "sport-tracker-workspace",
  "private": true,
  "scripts": {
    "security:install-hooks": "git config core.hooksPath .githooks",
    "security:secrets": "bash scripts/check-secrets.sh --tracked",
    "security:secrets:staged": "bash scripts/check-secrets.sh --staged",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "check": "npm --prefix backend run build && npm --prefix apps/web run typecheck",
    "check:backend": "npm --prefix backend run build",
    "check:web": "npm --prefix apps/web run typecheck",
    "check:mobile": "npm --prefix apps/mobile run check",
    "db:generate": "npm --prefix backend exec prisma generate",
    "db:migrate": "npm --prefix backend run db:migrate"
  }
}
