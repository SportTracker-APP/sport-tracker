RESEND_TEMPLATE_AUTH_VERIFY=auth-verify-email
RESEND_TEMPLATE_AUTH_WELCOME=auth-welcome
RESEND_TEMPLATE_AUTH_RESET_PASSWORD=auth-reset-password
RESEND_TEMPLATE_AUTH_PASSWORD_CHANGED=auth-password-changed
