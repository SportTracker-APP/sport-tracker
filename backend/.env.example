SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

SERVICE_NAME=hovren-backend
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-long-random-metrics-token
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300

RESEND_API_KEY=
MAIL_ENABLED=false
MAIL_FROM=Votre carnet outdoor <onboarding@resend.dev>
MAIL_REPLY_TO=support@example.test
MAIL_TEST_RECIPIENT=recipient@example.test
APP_BASE_URL=http://localhost:3000
APP_DEFAULT_TIMEZONE=Europe/Paris
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
