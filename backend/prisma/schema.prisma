generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  // PROFILE
  firstName String

  lastName String?

  city String?

  bio String?

  avatarUrl String?

  birthDate DateTime?

  weight Float?

  height Float?

  // AUTH
  email String @unique

  password String

  refreshToken String?

  emailVerifiedAt DateTime?

  role UserRole @default(USER)

  isBlocked Boolean @default(false)

  // SETTINGS
  isProfilePublic Boolean @default(false)

  // RELATIONS
  activities Activity[]

  goals Goal[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationTokens EmailVerificationToken[]

  scheduledEmails ScheduledEmail[]

  summitDiscoveries SummitDiscovery[]

  badges UserBadge[]

  geoAreaPreferences UserGeoAreaPreference[]

  onboardingStates UserOnboardingState[]

  summitImportRunsApplied SummitImportRun[] @relation("SummitImportRunAppliedBy")

  summitImportRunsPublished SummitImportRun[] @relation("SummitImportRunPublishedBy")

  summitImportCandidatesResolved SummitImportCandidate[] @relation("SummitImportCandidateResolvedBy")

  summitImportCandidatesApplied SummitImportCandidate[] @relation("SummitImportCandidateAppliedBy")

  summitTiersUpdated Summit[] @relation("SummitTierUpdatedBy")

  summitAdminAuditLogs SummitAdminAuditLog[]

  impersonationSessionsStarted AdminImpersonationSession[] @relation("AdminImpersonationAdmin")

  impersonationSessionsReceived AdminImpersonationSession[] @relation("AdminImpersonationTarget")

  // DATES
  createdAt DateTime @default(now())

  lastLoginAt DateTime?

  updatedAt DateTime @updatedAt

  stravaConnection StravaConnection?
}

model AdminImpersonationSession {
  id String @id @default(cuid())

  adminUserId String?

  targetUserId String?

  adminEmail String

  targetEmail String

  startedAt DateTime @default(now())

  expiresAt DateTime

  endedAt DateTime?

  ipAddress String?

  userAgent String?

  adminUser User? @relation("AdminImpersonationAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  targetUser User? @relation("AdminImpersonationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, startedAt])
  @@index([targetUserId, startedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Activity {
  id String @id @default(cuid())

  // CONTENT
  title String?

  description String?

  stravaActivityId String? @unique

  type ActivityType

  sport SportType

  status ActivityStatus @default(COMPLETED)

  // PERFORMANCE
  distance Float? // km

  duration Int // secondes

  movingTime Int? // secondes réelles en mouvement

  elevationGain Int? // mètres +

  elevationLoss Int? // mètres -

  maxAltitude Int? // mètres, point le plus haut atteint

  calories Int?

  steps Int?

  cadence Int?

  power Int?

  averageSpeed Float?

  maxSpeed Float?

  pace Float? // min/km

  averageHeartRate Int?

  maxHeartRate Int?

  // WEATHER
  temperature Float?

  weather WeatherType?

  // LOCATION
  startLatitude Float?

  startLongitude Float?

  endLatitude Float?

  endLongitude Float?

  city String?

  country String?

  routePolyline String?

  summitDetectionProcessedAt DateTime?

  summitDetectionVersion Int @default(0)

  // MEDIA
  coverImageUrl String?

  // SOCIAL
  isPublic Boolean @default(false)

  likesCount Int @default(0)

  commentsCount Int @default(0)

  // DATES
  startedAt DateTime

  endedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plannedWorkoutCompletion PlannedWorkoutCompletion? @relation("PlannedWorkout")

  completedWorkoutLink PlannedWorkoutCompletion? @relation("CompletedActivity")

  scheduledEmails ScheduledEmail[]

  summitDiscoveries SummitDiscovery[]

  @@index([userId])
  @@index([type])
  @@index([sport])
  @@index([startedAt])
  @@index([createdAt])
  @@index([userId, summitDetectionProcessedAt])
  @@index([userId, summitDetectionVersion])
}

model PlannedWorkoutCompletion {
  id String @id @default(cuid())

  plannedWorkoutId String @unique

  completedActivityId String @unique

  completedAt DateTime @default(now())

  celebrationSeenAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  plannedWorkout Activity @relation("PlannedWorkout", fields: [plannedWorkoutId], references: [id], onDelete: Cascade)

  completedActivity Activity @relation("CompletedActivity", fields: [completedActivityId], references: [id], onDelete: Cascade)

  @@index([plannedWorkoutId])
  @@index([completedActivityId])
}

model ScheduledEmail {
  id String @id @default(cuid())

  userId String

  activityId String

  type ScheduledEmailType

  status ScheduledEmailStatus @default(PENDING)

  scheduledAt DateTime

  sentAt DateTime?

  attemptCount Int @default(0)

  lastError String?

  processingStartedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, type])
  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

model Goal {
  id String @id @default(cuid())

  title String

  type GoalType

  sport SportType?

  target Float

  period GoalPeriod @default(MONTHLY)

  startDate DateTime

  endDate DateTime

  isActive Boolean @default(true)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@index([isPrimary])
  @@index([startDate])
  @@index([endDate])
}

model Summit {
  id String @id

  name String

  aliases String[]

  altitude Int

  massif String

  difficulty String

  type String

  longitude Float

  latitude Float

  imageUrl String?

  imageCredit String?

  sourceUrl String?

  editorialImageUrl String?

  editorialImageCredit String?

  editorialSourceUrl String?

  isActive Boolean @default(false)

  catalogStatus SummitCatalogStatus @default(DRAFT)

  catalogTier SummitCatalogTier @default(CORE)

  suggestedTier SummitCatalogTier?

  tierReason String?

  tierUpdatedAt DateTime?

  tierUpdatedByUserId String?

  primaryMassifId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  discoveries SummitDiscovery[]

  primaryMassif GeoArea? @relation("SummitPrimaryMassif", fields: [primaryMassifId], references: [id], onDelete: SetNull)

  tierUpdatedBy User? @relation("SummitTierUpdatedBy", fields: [tierUpdatedByUserId], references: [id], onDelete: SetNull)

  geoAreas SummitGeoArea[]

  adminAuditLogs SummitAdminAuditLog[]

  externalReferences SummitExternalReference[]

  importCandidates SummitImportCandidate[]

  @@index([massif])
  @@index([altitude])
  @@index([isActive])
  @@index([catalogStatus])
  @@index([catalogTier])
  @@index([primaryMassifId])
}

model SummitAdminAuditLog {
  id String @id @default(cuid())

  summitId String

  adminUserId String?

  action SummitAdminAuditAction

  before Json?

  after Json?

  createdAt DateTime @default(now())

  summit Summit @relation(fields: [summitId], references: [id], onDelete: Cascade)

  adminUser User? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([summitId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([action])
}

model GeoArea {
  id String @id @default(cuid())

  name String

  slug String @unique

  type GeoAreaType

  parentId String?

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  parent GeoArea? @relation("GeoAreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)

  children GeoArea[] @relation("GeoAreaHierarchy")

  summitLinks SummitGeoArea[]

  primarySummits Summit[] @relation("SummitPrimaryMassif")

  userPreferences UserGeoAreaPreference[]

  @@index([type])
  @@index([parentId])
  @@index([isPublished])
}

model SummitGeoArea {
  summitId String

  geoAreaId String

  createdAt DateTime @default(now())

  summit Summit @relation(fields: [summitId], references: [id], onDelete: Cascade)

  geoArea GeoArea @relation(fields: [geoAreaId], references: [id], onDelete: Cascade)

  @@id([summitId, geoAreaId])
  @@index([geoAreaId])
}

model UserGeoAreaPreference {
  id String @id @default(cuid())

  userId String

  geoAreaId String

  type UserGeoAreaPreferenceType

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  geoArea GeoArea @relation(fields: [geoAreaId], references: [id], onDelete: Cascade)

  @@unique([userId, geoAreaId, type])
  @@index([userId, type])
  @@index([geoAreaId])
}

model UserOnboardingState {
  id String @id @default(cuid())

  userId String

  key String

  version Int

  completedAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([key, version])
}

model SummitExternalReference {
  id String @id @default(cuid())

  summitId String

  provider SummitExternalProvider

  externalId String

  sourceVersion String

  sourceName String

  firstSeenAt DateTime @default(now())

  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  summit Summit @relation(fields: [summitId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([summitId])
}

model SummitImportRun {
  id String @id @default(cuid())

  provider SummitExternalProvider

  scope String

  sourceVersion String

  sourceName String

  sourceChecksum String?

  status SummitImportRunStatus @default(PREVIEWED)

  startedAt DateTime @default(now())

  completedAt DateTime?

  sourceCount Int @default(0)

  candidateCount Int @default(0)

  createdCount Int @default(0)

  matchedCount Int @default(0)

  conflictCount Int @default(0)

  rejectedCount Int @default(0)

  errorCount Int @default(0)

  preflightReport Json?

  appliedAt DateTime?

  appliedByUserId String?

  publishedAt DateTime?

  publishedByUserId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  appliedBy User? @relation("SummitImportRunAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)

  publishedBy User? @relation("SummitImportRunPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  candidates SummitImportCandidate[]

  @@unique([provider, sourceVersion, scope])
  @@index([provider, scope, startedAt])
  @@index([status])
}

model SummitImportCandidate {
  id String @id @default(cuid())

  importRunId String

  externalId String

  name String

  normalizedName String

  latitude Float

  longitude Float

  elevation Int?

  sourceNature String

  sourceProperties Json

  status SummitImportCandidateStatus

  suggestedTier SummitCatalogTier

  catalogTier SummitCatalogTier

  tierReason String

  classificationSignals Json

  isLegacyMatch Boolean @default(false)

  homonymGroupSize Int @default(1)

  resolutionAction SummitImportResolutionAction?

  matchedSummitId String?

  resolutionReason String?

  resolvedAt DateTime?

  resolvedByUserId String?

  appliedAt DateTime?

  appliedByUserId String?

  errorMessage String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  importRun SummitImportRun @relation(fields: [importRunId], references: [id], onDelete: Cascade)

  matchedSummit Summit? @relation(fields: [matchedSummitId], references: [id], onDelete: SetNull)

  resolvedBy User? @relation("SummitImportCandidateResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  appliedBy User? @relation("SummitImportCandidateAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)

  @@unique([importRunId, externalId])
  @@index([status])
  @@index([suggestedTier])
  @@index([catalogTier])
  @@index([importRunId, status])
  @@index([importRunId, catalogTier])
  @@index([importRunId, homonymGroupSize])
  @@index([resolutionAction])
  @@index([appliedAt])
  @@index([appliedByUserId])
  @@index([matchedSummitId])
}

model SummitDiscovery {
  id String @id @default(cuid())

  userId String

  summitId String

  activityId String

  status SummitDiscoveryStatus @default(PENDING)

  confirmationSource SummitDiscoveryConfirmationSource?

  confidence Float

  closestDistance Int

  altitudeMatched Boolean

  titleMatched Boolean

  routePointCount Int @default(0)

  nearbyPointCount Int @default(0)

  detectionVersion Int @default(1)

  detectedAt DateTime @default(now())

  discoveredAt DateTime

  confirmedAt DateTime?

  dismissedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  summit Summit @relation(fields: [summitId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  unlockedBadges UserBadge[]

  @@unique([summitId, activityId])
  @@index([userId, status])
  @@index([confirmationSource])
  @@index([userId, summitId])
  @@index([activityId])
  @@index([detectedAt])
  @@index([discoveredAt])
}

model Badge {
  id String @id

  name String

  description String

  hint String

  icon String

  tone String

  sortOrder Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users UserBadge[]

  @@index([sortOrder])
  @@index([isActive])
}

model UserBadge {
  id String @id @default(cuid())

  userId String

  badgeId String

  sourceDiscoveryId String?

  unlockedAt DateTime @default(now())

  notificationSentAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  sourceDiscovery SummitDiscovery? @relation(fields: [sourceDiscoveryId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([badgeId])
  @@index([sourceDiscoveryId])
  @@index([unlockedAt])
}

enum ActivityType {
  TRAINING
  RACE
  RECOVERY
  WALK
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  MISSED
  CANCELED
}

enum SportType {
  RUNNING
  TRAIL
  HIKING
  WALKING
  ROAD_CYCLING
  MTB
  GRAVEL
  SWIMMING
  GYM
  FITNESS
  SKI
  SNOWBOARD
  CLIMBING
}

enum WeatherType {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
  FOGGY
}

enum UserRole {
  USER
  ADMIN
}

enum ScheduledEmailType {
  ACTIVITY_UPCOMING_REMINDER
  ACTIVITY_COMPLETED_CONGRATULATIONS
}

enum ScheduledEmailStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum GoalType {
  DISTANCE_KM
  ACTIVITY_COUNT
  ELEVATION_M
  CALORIES
  DURATION_MIN
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum SummitDiscoveryStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

enum SummitDiscoveryConfirmationSource {
  AUTO
  USER
}

enum SummitCatalogStatus {
  DRAFT
  REVIEW
  READY
  ARCHIVED
}

enum SummitCatalogTier {
  CORE
  SECONDARY
  REFERENCE
}

enum SummitAdminAuditAction {
  SUMMIT_UPDATED
  STATUS_CHANGED
  PUBLICATION_CHANGED
  PRIMARY_MASSIF_CHANGED
  GEO_AREA_ADDED
  GEO_AREA_REMOVED
  IMPORT_BATCH_PUBLISHED
  IMPORT_COMPLEMENTARY_APPLIED
  MANUAL_SUMMIT_CREATED
  EDITORIAL_IMAGE_UPDATED
  EDITORIAL_IMAGE_REMOVED
  TIER_CHANGED
}

enum GeoAreaType {
  COUNTRY
  ADMIN_REGION
  DEPARTMENT
  MOUNTAIN_CHAIN
  MASSIF
  SUBMASSIF
  SECTOR
  NATURAL_PARK
}

enum UserGeoAreaPreferenceType {
  HOME_AREA
  FAVORITE
  DISCOVERY
}

enum SummitExternalProvider {
  IGN_BD_TOPO
}

enum SummitImportRunStatus {
  PREVIEWED
  PREPARED
  APPLIED
  PUBLISHED
  FAILED
}

enum SummitImportCandidateStatus {
  NEW
  MATCHED
  CONFLICT
  REJECTED
  READY
  IMPORTED
  SKIPPED
}

enum SummitImportResolutionAction {
  MATCH_EXISTING
  CREATE_NEW
  IGNORE
  KEEP_FOR_REVIEW
}

model StravaConnection {
  id String @id @default(cuid())

  userId String @unique

  athleteId String

  accessToken String

  refreshToken String

  expiresAt DateTime

  lastSyncAttemptAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
