generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  url = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  // PROFILE
  firstName String

  lastName String?

  city String?

  bio String?

  avatarUrl String?

  birthDate DateTime?

  weight Float?

  height Float?

  // AUTH
  email String @unique

  password String

  refreshToken String?

  emailVerifiedAt DateTime?

  role UserRole @default(USER)

  isBlocked Boolean @default(false)

  // SETTINGS
  isProfilePublic Boolean @default(false)

  // RELATIONS
  activities Activity[]

  goals Goal[]

  passwordResetTokens PasswordResetToken[]

  emailVerificationTokens EmailVerificationToken[]

  scheduledEmails ScheduledEmail[]

  summitDiscoveries SummitDiscovery[]

  badges UserBadge[]

  // DATES
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  stravaConnection StravaConnection?
}

model PasswordResetToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Activity {
  id String @id @default(cuid())

  // CONTENT
  title String?

  description String?

  stravaActivityId String? @unique

  type ActivityType

  sport SportType

  status ActivityStatus @default(COMPLETED)

  // PERFORMANCE
  distance Float? // km

  duration Int // secondes

  movingTime Int? // secondes réelles en mouvement

  elevationGain Int? // mètres +

  elevationLoss Int? // mètres -

  maxAltitude Int? // mètres, point le plus haut atteint

  calories Int?

  steps Int?

  cadence Int?

  power Int?

  averageSpeed Float?

  maxSpeed Float?

  pace Float? // min/km

  averageHeartRate Int?

  maxHeartRate Int?

  // WEATHER
  temperature Float?

  weather WeatherType?

  // LOCATION
  startLatitude Float?

  startLongitude Float?

  endLatitude Float?

  endLongitude Float?

  city String?

  country String?

  routePolyline String?

  // MEDIA
  coverImageUrl String?

  // SOCIAL
  isPublic Boolean @default(false)

  likesCount Int @default(0)

  commentsCount Int @default(0)

  // DATES
  startedAt DateTime

  endedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // RELATIONS
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  plannedWorkoutCompletion PlannedWorkoutCompletion? @relation("PlannedWorkout")

  completedWorkoutLink PlannedWorkoutCompletion? @relation("CompletedActivity")

  scheduledEmails ScheduledEmail[]

  summitDiscoveries SummitDiscovery[]

  @@index([userId])
  @@index([type])
  @@index([sport])
  @@index([startedAt])
  @@index([createdAt])
}

model PlannedWorkoutCompletion {
  id String @id @default(cuid())

  plannedWorkoutId String @unique

  completedActivityId String @unique

  completedAt DateTime @default(now())

  celebrationSeenAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  plannedWorkout Activity @relation("PlannedWorkout", fields: [plannedWorkoutId], references: [id], onDelete: Cascade)

  completedActivity Activity @relation("CompletedActivity", fields: [completedActivityId], references: [id], onDelete: Cascade)

  @@index([plannedWorkoutId])
  @@index([completedActivityId])
}

model ScheduledEmail {
  id String @id @default(cuid())

  userId String

  activityId String

  type ScheduledEmailType

  status ScheduledEmailStatus @default(PENDING)

  scheduledAt DateTime

  sentAt DateTime?

  attemptCount Int @default(0)

  lastError String?

  processingStartedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, type])
  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([scheduledAt])
  @@index([status, scheduledAt])
}

model Goal {
  id String @id @default(cuid())

  title String

  type GoalType

  sport SportType?

  target Float

  period GoalPeriod @default(MONTHLY)

  startDate DateTime

  endDate DateTime

  isActive Boolean @default(true)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
  @@index([isPrimary])
  @@index([startDate])
  @@index([endDate])
}

model Summit {
  id String @id

  name String

  aliases String[]

  altitude Int

  massif String

  difficulty String

  type String

  longitude Float

  latitude Float

  imageUrl String?

  imageCredit String?

  sourceUrl String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  discoveries SummitDiscovery[]

  @@index([massif])
  @@index([altitude])
  @@index([isActive])
}

model SummitDiscovery {
  id String @id @default(cuid())

  userId String

  summitId String

  activityId String

  status SummitDiscoveryStatus @default(PENDING)

  confidence Float

  closestDistance Int

  altitudeMatched Boolean

  titleMatched Boolean

  detectedAt DateTime @default(now())

  confirmedAt DateTime?

  dismissedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  summit Summit @relation(fields: [summitId], references: [id], onDelete: Cascade)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  unlockedBadges UserBadge[]

  @@unique([summitId, activityId])
  @@index([userId, status])
  @@index([userId, summitId])
  @@index([activityId])
  @@index([detectedAt])
}

model Badge {
  id String @id

  name String

  description String

  hint String

  icon String

  tone String

  sortOrder Int

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users UserBadge[]

  @@index([sortOrder])
  @@index([isActive])
}

model UserBadge {
  id String @id @default(cuid())

  userId String

  badgeId String

  sourceDiscoveryId String?

  unlockedAt DateTime @default(now())

  notificationSentAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  sourceDiscovery SummitDiscovery? @relation(fields: [sourceDiscoveryId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([badgeId])
  @@index([sourceDiscoveryId])
  @@index([unlockedAt])
}

enum ActivityType {
  TRAINING
  RACE
  RECOVERY
  WALK
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  MISSED
  CANCELED
}

enum SportType {
  RUNNING
  TRAIL
  HIKING
  WALKING
  ROAD_CYCLING
  MTB
  GRAVEL
  SWIMMING
  GYM
  FITNESS
  SKI
  SNOWBOARD
  CLIMBING
}

enum WeatherType {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
  FOGGY
}

enum UserRole {
  USER
  ADMIN
}

enum ScheduledEmailType {
  ACTIVITY_UPCOMING_REMINDER
  ACTIVITY_COMPLETED_CONGRATULATIONS
}

enum ScheduledEmailStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum GoalType {
  DISTANCE_KM
  ACTIVITY_COUNT
  ELEVATION_M
  CALORIES
  DURATION_MIN
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum SummitDiscoveryStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

model StravaConnection {
  id String @id @default(cuid())

  userId String @unique

  athleteId String

  accessToken String

  refreshToken String

  expiresAt DateTime

  lastSyncAttemptAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
