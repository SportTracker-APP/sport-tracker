PORT=4000
FRONTEND_URL=http://localhost:3000
STRAVA_CALLBACK_URL=http://localhost:4000/strava/callback
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=86400
STRAVA_STATE_SECRET=replace-with-a-long-random-strava-state-secret
# Generate with: openssl rand -base64 32
STRAVA_TOKEN_ENCRYPTION_KEYS=replace-with-a-base64-encoded-32-byte-key
STRAVA_CLIENT_ID=replace-with-strava-client-id
STRAVA_CLIENT_SECRET=replace-with-strava-client-secret
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

SERVICE_NAME=hovren-backend
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
METRICS_TOKEN=replace-with-a-long-random-metrics-token
ALERTS_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300

# Keep secrets in backend/.env or in your deployment platform.
# Add a local/dev database here only if you want to avoid touching production data:
# DATABASE_URL=postgresql://...

RESEND_API_KEY=
MAIL_ENABLED=false
MAIL_FROM=HOVREN - Ton carnet outdoor <noreply@hovren.fr>
MAIL_REPLY_TO=contact@hovren.fr
MAIL_TEST_RECIPIENT=recipient@example.test
MAIL_SMOKE_TYPE=auth.welcome
APP_BASE_URL=http://localhost:3000
APP_DEFAULT_TIMEZONE=Europe/Paris
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
